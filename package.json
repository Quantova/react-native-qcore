  "react-native": "ts/index.ts",
  "source": "ts/index.ts",
  "types": "ts/index.ts",
  "scripts": {
    "bindgen": "bash scripts/generate-bindings.sh",
    "build:android": "bash scripts/build-android.sh",
    "build:ios": "bash scripts/build-ios.sh",
    "build:ts": "tsc -p tsconfig.json"
  },
  "keywords": [
    "post-quantum",
    "quantum-resistant",
    "quantum-safe",
    "react-native",
    "blockchain",
    "wallet",
    "cryptography",
    "ml-dsa",
    "quantova",
    "uniffi"
  ],
  "license": "(Apache-2.0 OR MIT)",
  "author": "Quantova Inc",
  "homepage": "https://github.com/Quantova/react-native-qcore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantova/react-native-qcore.git"
  },
  "bugs": {
    "url": "https://github.com/Quantova/react-native-qcore/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "files": [
    "ts",
    "android/build.gradle",
    "android/src",
    "ios/Qcore.swift",
